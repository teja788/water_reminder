{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_COUNTS_URL": "https://app-counts.vivekananda-archive.workers.dev/c"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "simulator"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_COUNTS_URL": "https://app-counts.vivekananda-archive.workers.dev/c"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801325939",
        "appleTeamId": "9WU98AXT3W"
      }
    }
  }
}
