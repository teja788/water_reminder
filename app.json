{
  "expo": {
    "name": "Water Reminder",
    "slug": "water_reminder",
    "owner": "seeker88",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appStoreUrl": "https://apps.apple.com/app/id6801325939",
      "bundleIdentifier": "com.teja788.waterreminder",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E88E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAFD",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E1620"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "de",
            "es",
            "fr",
            "it",
            "ja",
            "ko",
            "nl",
            "pl",
            "pt",
            "tr",
            "zh-Hant"
          ]
        }
      ],
      "./plugins/withWidgetLocalizations",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "SipWidget",
              "displayName": "Sip",
              "description": "Today's water at a glance. Tap to log a cup.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9653679-ef86-431f-9f9a-a6e0351323f5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9653679-ef86-431f-9f9a-a6e0351323f5"
    }
  }
}
