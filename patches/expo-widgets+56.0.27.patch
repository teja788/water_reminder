+/// Sip patch: removes this app's pending local notifications due before `limit`.
+private func cancelPendingNotifications(before limit: Date) async {
+  let center = UNUserNotificationCenter.current()
+  let ids = await center.pendingNotificationRequests().filter { request in
+    let next = (request.trigger as? UNCalendarNotificationTrigger)?.nextTriggerDate()
+      ?? (request.trigger as? UNTimeIntervalNotificationTrigger)?.nextTriggerDate()
+    return next.map { $0 < limit } ?? false
+  }.map(\.identifier)
+  center.removePendingNotificationRequests(withIdentifiers: ids)
+}
